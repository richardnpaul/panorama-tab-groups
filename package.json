{
  "name": "tab-groups-viewer",
  "version": "0.1.0",
  "description": "Tab Groups Viewer",
  "type": "module",
  "scripts": {
    "act:list": "act -l",
    "act:run": "act",
    "audit:check": "npm audit --audit-level=low",
    "build": "npm-run-all2 dist dist:firefox && web-ext build -s dist-firefox",
    "build:xpi": "npm-run-all2 dist dist:firefox && web-ext build -s dist-firefox --artifacts-dir . --filename extension.xpi --overwrite-dest",
    "dist": "npm-run-all2 dist:clean dist:tsc dist:static",
    "dist:clean": "node -e \"['dist', 'dist-firefox'].forEach((dir) => require('node:fs').rmSync(dir, { recursive: true, force: true }))\"",
    "dist:firefox": "tsx scripts/build-firefox.ts",
    "dist:static": "tsx scripts/copy-static.ts",
    "dist:tsc": "tsc -p tsconfig.build.json",
    "format": "npm-run-all2 format:*",
    "format:prettier": "prettier --write .",
    "format:oxlint": "oxlint --fix",
    "lint": "npm-run-all2 lint:*",
    "lint:knip": "knip",
    "lint:prettier": "prettier --check .",
    "lint:oxlint": "oxlint",
    "lint:suppressions": "tsx scripts/check-no-suppressions.ts",
    "lint:typecheck": "npm run typecheck",
    "lint:webext": "npm-run-all2 dist dist:firefox && web-ext -s dist-firefox lint",
    "precommit": "pre-commit run",
    "pretest:e2e": "npm-run-all2 dist dist:firefox",
    "start": "npm-run-all2 dist dist:firefox && web-ext run -s dist-firefox",
    "report:locales": "tsx scripts/locale-report.ts",
    "test": "npm-run-all2 test:lint test:coverage",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:lint": "npm run lint",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "watch": "npm run dist && npm-run-all2 --parallel watch:tsc watch:static watch:ext",
    "watch:ext": "web-ext run -s dist",
    "watch:static": "node --watch-path=src --import tsx scripts/copy-static.ts",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardnpaul/tab-groups-viewer.git"
  },
  "authors": [
    "Reuben Castelino",
    "Richard Paul"
  ],
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/richardnpaul/tab-groups-viewer/issues"
  },
  "homepage": "https://github.com/richardnpaul/tab-groups-viewer#readme",
  "devDependencies": {
    "@devicefarmer/adbkit": "3.3.9",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-istanbul": "4.1.12",
    "deepmerge": "4.3.1",
    "fast-check": "4.10.2",
    "jsdom": "30.1.3",
    "knip": "6.41.0",
    "npm-run-all2": "9.0.3",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.1",
    "playwright-webextext": "^0.0.5",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "web-ext": "^10.2.0"
  },
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "tools/adbkit-stub",
    "tools/deepmerge-patched",
    "tools/minimatch-compat"
  ],
  "overrides": {
    "minimatch": "file:tools/minimatch-compat"
  }
}
