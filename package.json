{
  "name": "tab-groups-viewer",
  "version": "0.9.0",
  "description": "Tab Groups Viewer",
  "main": "index.js",
  "scripts": {
    "test": "npm-run-all test:lint test:coverage",
    "test:lint": "npm run lint",
    "lint": "npm-run-all lint:*",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint --ext=.js,.mjs,.ts,.json .",
    "lint:webext": "npm run dist && web-ext -s dist lint",
    "lint:typecheck": "npm run typecheck",
    "lint:suppressions": "tsx scripts/check-no-suppressions.ts",
    "format": "npm-run-all format:*",
    "format:prettier": "prettier --write .",
    "format:eslint": "eslint --ext=.js,.mjs,.ts,.json --fix .",
    "precommit": "pre-commit run",
    "dist:clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dist:tsc": "tsc -p tsconfig.build.json",
    "dist:static": "tsx scripts/copy-static.ts",
    "dist": "npm-run-all dist:clean dist:tsc dist:static",
    "build": "npm run dist && web-ext build -s dist",
    "build:xpi": "npm run dist && web-ext build -s dist --artifacts-dir . --filename extension.xpi --overwrite-dest",
    "watch": "npm run dist && npm-run-all --parallel watch:tsc watch:static watch:ext",
    "watch:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "watch:static": "node --watch-path=src --import tsx scripts/copy-static.ts",
    "watch:ext": "web-ext run -s dist",
    "start": "npm run dist && web-ext run -s dist",
    "pretest:e2e": "npm run dist",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:mutation": "stryker run",
    "test:mutation:full": "stryker run --force",
    "audit:check": "npm audit --audit-level=low",
    "typecheck": "tsc --noEmit",
    "act:list": "act -l",
    "act:run": "act"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardnpaul/panorama-tab-groups.git"
  },
  "authors": [
    "Reuben Castelino",
    "Richard Paul"
  ],
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/richardnpaul/panorama-tab-groups/issues"
  },
  "homepage": "https://github.com/richardnpaul/panorama-tab-groups#readme",
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-json": "^3.1.0",
    "jsdom": "30.1.3",
    "npm-run-all": "^4.1.5",
    "playwright": "1.59.1",
    "prettier": "^3.8.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "web-ext": "^10.2.0"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "playwright-webextext": "^0.0.5",
    "tslib": "^2.8.1"
  },
  "workspaces": [
    "tools/adbkit-stub"
  ]
}
