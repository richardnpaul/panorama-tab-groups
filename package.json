{
  "name": "tab-groups-viewer",
  "version": "0.9.0",
  "description": "Tab Groups Viewer",
  "main": "index.js",
  "scripts": {
    "test": "npm-run-all test:lint",
    "test:lint": "npm run lint",
    "lint": "npm-run-all lint:*",
    "lint:prettier": "prettier --check .",
    "lint:eslint": "eslint --ext=.js,.ts,.json .",
    "lint:webext": "web-ext -s src lint",
    "lint:typecheck": "npm run typecheck",
    "format": "npm-run-all format:*",
    "format:prettier": "prettier --write .",
    "format:eslint": "eslint --ext=.js,.ts,.json --fix .",
    "precommit": "pre-commit run",
    "build": "web-ext build -s src",
    "build:xpi": "web-ext build -s src --artifacts-dir . --filename extension.xpi --overwrite-dest",
    "watch": "web-ext run -s src",
    "start": "web-ext run -s src",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richardnpaul/panorama-tab-groups.git"
  },
  "authors": [
    "Reuben Castelino",
    "Richard Paul"
  ],
  "license": "MPL-2.0",
  "bugs": {
    "url": "https://github.com/richardnpaul/panorama-tab-groups/issues"
  },
  "homepage": "https://github.com/richardnpaul/panorama-tab-groups#readme",
  "devDependencies": {
    "@playwright/mcp": "^0.0.75",
    "@playwright/test": "1.60.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/typescript-checker": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@types/firefox-webext-browser": "143.0.1",
    "@types/node": "24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-json": "^3.1.0",
    "jsdom": "30.1.3",
    "npm-run-all": "^4.1.5",
    "playwright": "1.59.1",
    "prettier": "^3.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12",
    "web-ext": "^10.2.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "playwright-webextext": "^0.0.5",
    "tslib": "^2.8.1"
  }
}
